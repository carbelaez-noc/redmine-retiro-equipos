<% helper = FibrazoRetiroEquipos::SettingsHelper %>
<% all_trackers = Tracker.order(:name).pluck(:name) %>
<% current_dest = helper.switch_tracker_name %>
<% current_sub = helper.trigger_subcategoria %>
<% sub_opts = (helper.trigger_subcategoria_opciones + [current_sub]).compact.uniq %>
<% motivos = helper.trigger_opciones_detalle %>
<% motivos_sel = helper.trigger_motivos %>
<fieldset class="box tabular">
  <legend>Retiro de equipos: cambio automático de tracker</legend>
  <p>
    <label for="settings_enabled">Activado</label>
    <%= check_box_tag 'settings[enabled]', '1', helper.enabled?, id: 'settings_enabled' %>
    <em class="info">Al tipificar un motivo de retiro en un caso nuevo, el tracker cambia al destino.</em>
  </p>
  <p>
    <label for="settings_switch_tracker_name">Tracker destino</label>
    <%= select_tag 'settings[switch_tracker_name]',
          options_for_select(all_trackers, current_dest) %>
    <em class="info">Aquí se crea el caso (por defecto: Retiro de ONU/TV Box).</em>
  </p>
  <p>
    <label for="settings_trigger_subcategoria">Subcategoría</label>
    <%= select_tag 'settings[trigger_subcategoria]',
          options_for_select(sub_opts, current_sub) %>
    <em class="info">Disparadora adicional (cubre variantes por equipo).</em>
  </p>
</fieldset>
<fieldset class="box">
  <legend>Motivos que disparan</legend>
  <div class="retiro-motivos-list">
    <%= hidden_field_tag 'settings[trigger_motivos][]', '' %>
    <% motivos.each do |m| %>
      <label for="retiro_motivo_<%= m[:reason].parameterize %>" style="display:block;margin:2px 0">
        <%= check_box_tag 'settings[trigger_motivos][]', m[:reason], motivos_sel.include?(m[:reason]),
              id: "retiro_motivo_#{m[:reason].parameterize}" %>
        <strong><%= h m[:reason] %></strong><% if m[:contextos].any? %> <span style="color:#64748b;font-weight:normal">(<%= h m[:contextos].join(' | ') %>)</span><% end %>
      </label>
    <% end %>
  </div>
  <em class="info">Solo estos motivos cambian el tracker. Vacío = ningún cambio.</em>
</fieldset>
